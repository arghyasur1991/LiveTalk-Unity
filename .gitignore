# This is a Unity package, not a project: .meta files are tracked (Unity
# needs them for everything outside Samples~), and only tool and OS
# by-products are ignored.

# UPM sample folders end in "~". A common global ignore ("*~" for editor
# backup files) would silently drop them; re-include explicitly.
!Samples~/
!Samples~/**
!Tools~/
!Tools~/**

# OS
.DS_Store
Thumbs.db

# Unity project folders that appear when the package is opened as a project
Library/
Temp/
Logs/
obj/
UserSettings/
*.log

# IDE
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs

# Python by-products from any export scripts
__pycache__/
*.pyc

# Model weights are never committed
*.onnx
*.onnx.data
*.onnx_data

# FasterLivePortrait writes <clip>.pkl next to a driving video it is run on
*.pkl
